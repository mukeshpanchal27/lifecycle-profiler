<?xml version="1.0"?>
<phpunit
	bootstrap="tests/phpunit/bootstrap.php"
	backupGlobals="false"
	colors="true"
	convertDeprecationsToExceptions="true"
	>
	<php>
		<const name="WP_TESTS_MULTISITE" value="1" />
	</php>
	<testsuites>
		<testsuite name="Lifecycle Profiler multisite">
			<directory prefix="class-test-" suffix=".php">./tests/phpunit/tests/</directory>
		</testsuite>
	</testsuites>
	<groups>
		<exclude>
			<group>ms-excluded</group>
		</exclude>
	</groups>
</phpunit>
