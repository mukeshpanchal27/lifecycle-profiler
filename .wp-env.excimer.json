{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"phpVersion": "7.4",
	"plugins": [
		"."
	],
	"port": 8890,
	"testsEnvironment": false,
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
